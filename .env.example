# XPO India — Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# App
NEXT_PUBLIC_APP_URL=https://xpoindia.com
NEXT_PUBLIC_APP_NAME="XPO India"

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/xpo-india?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=https://xpoindia.com
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# PayPal (International)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="XPO India <noreply@xpoindia.com>"

# WhatsApp
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# SMS
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Seed / Demo
SEED_ADMIN_EMAIL=admin@xpoindia.com
SEED_ADMIN_PASSWORD=XPOAdmin@2024
SEED_ADMIN_NAME="XPO Superadmin"
